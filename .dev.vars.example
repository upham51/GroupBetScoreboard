# Copy to .dev.vars for local development. .dev.vars is gitignored.
# In production these are set in the Cloudflare Pages project settings
# (Settings -> Environment variables), not in any committed file.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"

# Cloudflare Turnstile. Without the secret key, creating a group and logging a
# result both refuse to write; reads are unaffected.
# For local work, Cloudflare publishes test keys that always pass:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# and a secret that always fails, for checking the rejection path:
#   secret 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY = "your-turnstile-site-key"
TURNSTILE_SECRET_KEY = "your-turnstile-secret-key"
